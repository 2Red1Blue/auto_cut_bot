# Copy this file to .env on the desktop that runs ASR.  Do not commit .env.
# Both source paths must be exact, immutable model snapshot directories.
FUNASR_ASR_MODEL_DIR=/absolute/path/to/iic--SenseVoiceSmall/snapshots/master
FUNASR_ASR_MODEL_REVISION=master
FUNASR_VAD_MODEL_DIR=/absolute/path/to/iic--speech_fsmn_vad_zh-cn-16k-common-pytorch/snapshots/v2.0.4
FUNASR_VAD_MODEL_REVISION=v2.0.4

# This port is loopback-only.  It intentionally does not use the gateway's 8765.
FUNASR_HOST_PORT=18765
FUNASR_REQUIRED_PYTHON_VERSION=3.13.13
FUNASR_MAX_REQUEST_BYTES=2147483648
FUNASR_MAX_RESPONSE_BYTES=16777216
FUNASR_INFERENCE_TIMEOUT_SECONDS=180
FUNASR_QUEUE_CAPACITY=3
FUNASR_STARTUP_MIN_AVAILABLE_BYTES=8589934592
FUNASR_INFERENCE_MIN_AVAILABLE_BYTES=4294967296
FUNASR_MAX_SWAP_USED_BYTES=2147483648

# `configured` is the normal service mode. `shadow` self-measures a CUDA
# calibration identity and refuses a supplied profile; it cannot serve normal
# timed speech. Never commit the filled copy of this file.
FUNASR_MODE=configured
FUNASR_SHARED_TOKEN=replace-with-a-random-local-token
FUNASR_PROFILE_JSON=
