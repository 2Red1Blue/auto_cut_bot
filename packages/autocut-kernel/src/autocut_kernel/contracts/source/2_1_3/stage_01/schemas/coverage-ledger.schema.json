{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocut.invalid/contracts/2.1.3/stage_01/schemas/coverage-ledger.schema.json",
  "$comment": "Owner payload source only; no Envelope, Artifact identity, Registry, command, producer, writer, rule registration, trace identity, or readiness semantics.",
  "type": "object",
  "properties": {
    "ledger_id": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coverage_id": {
            "type": "string"
          },
          "unit_type": {
            "type": "string"
          },
          "unit_ref": {
            "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
          },
          "resolution_status": {
            "enum": [
              "resolved",
              "unresolved",
              "conflicted"
            ]
          },
          "disposition": {
            "enum": [
              "narrative",
              "supporting",
              "intentionally_excluded",
              "unassigned"
            ]
          },
          "graph_node_refs": {
            "type": "array",
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
            }
          },
          "exclusion_evidence": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "classification": {
                    "enum": [
                      "recap",
                      "preview",
                      "bts",
                      "water_content",
                      "credits"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
                    }
                  },
                  "rule_id": {
                    "const": "KC-EXCLUDE-001"
                  },
                  "rule_version": {
                    "const": "1.0.0"
                  }
                },
                "required": [
                  "classification",
                  "evidence_refs",
                  "rule_id",
                  "rule_version"
                ],
                "additionalProperties": false
              }
            ]
          },
          "diagnostic_refs": {
            "type": "array",
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
            }
          },
          "taint_seed_refs": {
            "type": "array",
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
            }
          }
        },
        "required": [
          "coverage_id",
          "unit_type",
          "unit_ref",
          "resolution_status",
          "disposition",
          "graph_node_refs",
          "evidence_refs",
          "exclusion_evidence",
          "diagnostic_refs",
          "taint_seed_refs"
        ],
        "additionalProperties": false
      }
    },
    "conservation": {
      "type": "object",
      "properties": {
        "input_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "ledger_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_event_refs": {
          "type": "array",
          "items": {
            "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
          }
        },
        "missing_event_refs": {
          "type": "array",
          "items": {
            "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
          }
        }
      },
      "required": [
        "input_event_count",
        "ledger_event_count",
        "duplicate_event_refs",
        "missing_event_refs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ledger_id",
    "rows",
    "conservation"
  ],
  "additionalProperties": false
}
