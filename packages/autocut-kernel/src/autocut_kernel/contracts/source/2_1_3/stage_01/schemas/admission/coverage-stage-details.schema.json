{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocut.invalid/contracts/2.1.3/stage_01/schemas/admission/coverage-stage-details.schema.json",
  "$comment": "Owner payload source only; no Envelope, Artifact identity, Registry, command, producer, writer, rule registration, trace identity, or readiness semantics.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "coverage"
    },
    "coverage_mode": {
      "enum": [
        "strict_global",
        "dependency_scoped"
      ]
    },
    "taint_seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taint_seed_id": {
            "type": "string"
          },
          "coverage_id": {
            "type": "string"
          },
          "unit_ref": {
            "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
          },
          "reason": {
            "enum": [
              "unresolved",
              "conflicted"
            ]
          },
          "isolation_status": {
            "enum": [
              "bounded",
              "unbounded"
            ]
          },
          "dependency_root_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
            }
          },
          "affected_graph_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "diagnostic_refs": {
            "type": "array",
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
            }
          },
          "isolation_evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
            }
          }
        },
        "required": [
          "taint_seed_id",
          "coverage_id",
          "unit_ref",
          "reason",
          "isolation_status",
          "dependency_root_refs",
          "affected_graph_node_ids",
          "diagnostic_refs",
          "isolation_evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "dependency_closure_proof_ref": {
      "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/artifact-ref.schema.json"
    },
    "taint_seeds_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dependency_closure_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "coverage_mode",
    "taint_seeds",
    "dependency_closure_proof_ref",
    "taint_seeds_hash",
    "dependency_closure_hash"
  ],
  "additionalProperties": false
}
