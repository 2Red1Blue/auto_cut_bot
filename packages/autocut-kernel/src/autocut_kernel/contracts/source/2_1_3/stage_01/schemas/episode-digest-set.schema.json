{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocut.invalid/contracts/2.1.3/stage_01/schemas/episode-digest-set.schema.json",
  "$comment": "Owner payload source only; no Envelope, Artifact identity, Registry, command, producer, writer, rule registration, trace identity, or readiness semantics.",
  "type": "object",
  "properties": {
    "episode_digest_set_id": {
      "type": "string",
      "minLength": 1
    },
    "digests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "episode_id": {
            "type": "string",
            "minLength": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string"
          },
          "source_window_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
            }
          }
        },
        "required": [
          "episode_id",
          "ordinal",
          "summary",
          "source_window_refs",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "episode_digest_set_id",
    "digests"
  ],
  "additionalProperties": false
}
