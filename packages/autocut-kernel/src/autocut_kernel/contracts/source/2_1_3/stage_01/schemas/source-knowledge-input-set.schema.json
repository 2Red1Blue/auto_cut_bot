{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocut.invalid/contracts/2.1.3/stage_01/schemas/source-knowledge-input-set.schema.json",
  "$comment": "Owner payload source only; no Envelope, Artifact identity, Registry, command, producer, writer, rule registration, trace identity, or readiness semantics.",
  "type": "object",
  "properties": {
    "source_knowledge_input_set_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "ingestion_mode": {
            "enum": [
              "api_script",
              "api_only",
              "media_only"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "script"
                    },
                    "blob_ref": {
                      "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/immutable-blob-ref.schema.json"
                    },
                    "schema_contract_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "language": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "blob_ref",
                    "schema_contract_hash",
                    "language"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "episode_metadata"
                    },
                    "blob_ref": {
                      "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/immutable-blob-ref.schema.json"
                    },
                    "schema_contract_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "kind",
                    "blob_ref",
                    "schema_contract_hash"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "character_metadata"
                    },
                    "blob_ref": {
                      "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/immutable-blob-ref.schema.json"
                    },
                    "schema_contract_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "kind",
                    "blob_ref",
                    "schema_contract_hash"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "relationship_metadata"
                    },
                    "blob_ref": {
                      "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/immutable-blob-ref.schema.json"
                    },
                    "schema_contract_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "kind",
                    "blob_ref",
                    "schema_contract_hash"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "legacy_semantic_hint"
                    },
                    "blob_ref": {
                      "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/immutable-blob-ref.schema.json"
                    },
                    "schema_contract_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "kind",
                    "blob_ref",
                    "schema_contract_hash"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "source_id",
          "ingestion_mode",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source_knowledge_input_set_id",
    "sources"
  ],
  "additionalProperties": false
}
