{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocut.invalid/contracts/2.1.3/stage_01/schemas/event-card-set.schema.json",
  "$comment": "Owner payload source only; no Envelope, Artifact identity, Registry, command, producer, writer, rule registration, trace identity, or readiness semantics.",
  "type": "object",
  "properties": {
    "event_card_set_id": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "episode_id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          },
          "source_range_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/source-span-ref.schema.json"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/domain-ref.schema.json"
            }
          }
        },
        "required": [
          "event_id",
          "episode_id",
          "content",
          "source_range_refs",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "event_card_set_id",
    "events"
  ],
  "additionalProperties": false
}
