{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocut.invalid/contracts/2.1.3/common/contributions/common-system-direct-contribution-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "contract_version", "selection", "producer_base_commit", "foundation_input", "b0_evidence", "selected", "not_selected", "status"],
  "properties": {
    "format": {"const": "autocut.common-system-direct-contribution/v1"},
    "contract_version": {"const": "2.1.3"},
    "selection": {"const": "directly_transcribable_only"},
    "producer_base_commit": {"$ref": "#/$defs/gitCommit"},
    "foundation_input": {"$ref": "#/$defs/foundation"},
    "b0_evidence": {"$ref": "#/$defs/b0Evidence"},
    "selected": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/selected"}},
    "not_selected": {"type": "array", "minItems": 35, "items": {"$ref": "#/$defs/notSelected"}},
    "status": {"$ref": "#/$defs/status"}
  },
  "$defs": {
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "foundation": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_git_commit", "handoff_git_commit", "handoff_raw_sha256"],
      "properties": {"producer_git_commit": {"$ref": "#/$defs/gitCommit"}, "handoff_git_commit": {"$ref": "#/$defs/gitCommit"}, "handoff_raw_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "b0Evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory_path", "inventory_raw_sha256", "provenance_path", "provenance_raw_sha256", "authority_commit"],
      "properties": {"inventory_path": {"$ref": "#/$defs/path"}, "inventory_raw_sha256": {"$ref": "#/$defs/sha256"}, "provenance_path": {"$ref": "#/$defs/path"}, "provenance_raw_sha256": {"$ref": "#/$defs/sha256"}, "authority_commit": {"$ref": "#/$defs/gitCommit"}}
    },
    "testPath": {"type": "object", "additionalProperties": false, "required": ["path", "raw_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "raw_sha256": {"$ref": "#/$defs/sha256"}}},
    "authorityEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["historical_schema_comment", "reattested"],
      "properties": {"historical_schema_comment": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "reattested": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    },
    "selected": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "source_path", "source_raw_sha256", "source_jcs_sha256", "test_paths", "acceptance", "deferred_semantics", "authority_evidence"],
      "properties": {"candidate_id": {"type": "string", "pattern": "^B0-[0-9]{3}$"}, "source_path": {"$ref": "#/$defs/path"}, "source_raw_sha256": {"$ref": "#/$defs/sha256"}, "source_jcs_sha256": {"$ref": "#/$defs/sha256"}, "test_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/testPath"}}, "acceptance": {"const": "closed_payload_source_only"}, "deferred_semantics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "authority_evidence": {"$ref": "#/$defs/authorityEvidence"}}
    },
    "notSelected": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "disposition", "owner", "authority_change_ids"],
      "properties": {"candidate_id": {"type": "string", "pattern": "^B0-[0-9]{3}$"}, "disposition": {"enum": ["authority_change_required", "awaiting_owner"]}, "owner": {"type": "string", "minLength": 1}, "authority_change_ids": {"type": "array", "items": {"type": "string", "pattern": "^AC-B-[0-9]{3}$"}}}
    },
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["common_pack_ready", "registry_entries_declared", "generated_output_declared", "registry_contribution_authorized"],
      "properties": {"common_pack_ready": {"const": false}, "registry_entries_declared": {"const": false}, "generated_output_declared": {"const": false}, "registry_contribution_authorized": {"const": false}}
    }
  }
}
