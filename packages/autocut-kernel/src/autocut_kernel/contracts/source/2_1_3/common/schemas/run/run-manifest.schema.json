{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$vocabulary": {"https://json-schema.org/draft/2020-12/vocab/format-assertion": true},
  "$id": "https://autocut.invalid/contracts/2.1.3/common/schemas/run/run-manifest.schema.json",
  "$comment": "Authority: 原理/v2.1-production-spec/v2-production-system-contracts.md#3.4; sha256:c34af7451919ad9a895644b40136062834b7ba9e857139f10b61f7dc51be67e9. B2b is a closed payload-only transcription; payload-reference equality, semantic scope selection and ordering, Envelope inputs, Store/CAS, Registry, and authority/F evaluation remain deferred.",
  "type": "object",
  "properties": {
    "run_id": {"$ref": "#/$defs/non_empty_text"},
    "job_id": {"$ref": "#/$defs/non_empty_text"},
    "runtime_mode": {"enum": ["pipeline_unattended", "agent_native"]},
    "runtime_version": {"$ref": "#/$defs/non_empty_text"},
    "contract_version": {"const": "2.1.3"},
    "job_execution_id": {"$ref": "#/$defs/non_empty_text"},
    "prior_job_start_slot_ref": {"$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/artifact-ref.schema.json"},
    "run_lineage_id": {"$ref": "#/$defs/non_empty_text"},
    "publication_lineage_id": {"$ref": "#/$defs/non_empty_text"},
    "derivation_reason": {"enum": ["root", "runtime_switch", "policy_change", "new_external_fact", "portfolio_replan"]},
    "changed_ref_set": {"$ref": "#/$defs/changed_ref_set"},
    "affected_scope_set": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/scope.schema.json"}
    },
    "recovery_budget_epoch_id": {"$ref": "#/$defs/non_empty_text"},
    "job_policy_ref": {"$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/artifact-ref.schema.json"},
    "root_input_set_ref": {"$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/artifact-set-ref.schema.json"},
    "parent_run_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/parent_run_ref"}]},
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "required": ["run_id", "job_id", "runtime_mode", "runtime_version", "contract_version", "job_execution_id", "prior_job_start_slot_ref", "run_lineage_id", "publication_lineage_id", "derivation_reason", "changed_ref_set", "affected_scope_set", "recovery_budget_epoch_id", "job_policy_ref", "root_input_set_ref", "parent_run_ref", "created_at"],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "derivation_reason": {"const": "root"},
        "changed_ref_set": {"const": []},
        "affected_scope_set": {"minItems": 1, "maxItems": 1},
        "parent_run_ref": {"type": "null"}
      }
    },
    {
      "properties": {
        "derivation_reason": {"enum": ["runtime_switch", "policy_change", "new_external_fact", "portfolio_replan"]},
        "parent_run_ref": {"$ref": "#/$defs/parent_run_ref"}
      }
    }
  ],
  "$defs": {
    "non_empty_text": {"type": "string", "minLength": 1},
    "parent_run_ref": {
      "type": "object",
      "properties": {
        "run_id": {"$ref": "#/$defs/non_empty_text"},
        "artifact_id": {"$ref": "#/$defs/non_empty_text"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "required": ["run_id", "artifact_id", "content_hash"],
      "additionalProperties": false
    },
    "root_input_set_change": {
      "type": "object",
      "properties": {
        "kind": {"const": "root_input_set"},
        "parent_ref": {"$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/artifact-set-ref.schema.json"},
        "child_ref": {"$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/artifact-set-ref.schema.json"}
      },
      "required": ["kind", "parent_ref", "child_ref"],
      "additionalProperties": false
    },
    "job_policy_change": {
      "type": "object",
      "properties": {
        "kind": {"const": "job_policy"},
        "parent_ref": {"$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/artifact-ref.schema.json"},
        "child_ref": {"$ref": "https://autocut.invalid/contracts/2.1.3/common/schemas/primitives/artifact-ref.schema.json"}
      },
      "required": ["kind", "parent_ref", "child_ref"],
      "additionalProperties": false
    },
    "changed_ref_set": {
      "type": "array",
      "oneOf": [
        {"maxItems": 0},
        {"prefixItems": [{"$ref": "#/$defs/root_input_set_change"}], "minItems": 1, "maxItems": 1},
        {"prefixItems": [{"$ref": "#/$defs/job_policy_change"}], "minItems": 1, "maxItems": 1},
        {"prefixItems": [{"$ref": "#/$defs/root_input_set_change"}, {"$ref": "#/$defs/job_policy_change"}], "minItems": 2, "maxItems": 2}
      ]
    }
  }
}
