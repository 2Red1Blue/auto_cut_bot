{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocut.invalid/contracts/2.1.3/common/schema-meta/transition.schema.json",
  "$comment": "Authority: 00-contract-toolchain-and-command-kernel.md#3.1. Grammar for x-autocut-transition only; this template declares no actual transition.",
  "type": "object",
  "properties": {
    "transition_id": {"type": "string", "pattern": "^transition:[^\\s]+$"},
    "from_state": {"type": "string", "pattern": "^state:[^\\s]+$"},
    "to_state": {"type": "string", "pattern": "^state:[^\\s]+$"}
  },
  "required": ["transition_id", "from_state", "to_state"],
  "additionalProperties": false
}
