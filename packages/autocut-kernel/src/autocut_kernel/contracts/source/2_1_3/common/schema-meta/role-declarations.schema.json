{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocut.invalid/contracts/2.1.3/common/schema-meta/role-declarations.schema.json",
  "$comment": "Authority: 00-contract-toolchain-and-command-kernel.md#3.1. Grammar for x-autocut-role-declarations only; all business identities are supplied by a later owner pack.",
  "type": "object",
  "properties": {
    "input": {"$ref": "#/$defs/role_declaration_list"},
    "policy": {"$ref": "#/$defs/role_declaration_list"},
    "lifecycle_slots": {
      "type": "array",
      "items": {"enum": ["initial", "recovery", "reconcile", "migration", "bootstrap"]},
      "uniqueItems": true
    }
  },
  "required": ["input", "policy", "lifecycle_slots"],
  "additionalProperties": false,
  "$defs": {
    "role_declaration_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/role_declaration"},
      "uniqueItems": true
    },
    "role_declaration": {
      "type": "object",
      "properties": {
        "role": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "artifact_types": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_:-]*$"},
          "uniqueItems": true
        },
        "scope_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "uniqueItems": true
        },
        "min_refs": {"type": "integer", "minimum": 0},
        "max_refs": {"type": "integer", "minimum": 0}
      },
      "required": ["role", "artifact_types", "scope_kinds", "min_refs", "max_refs"],
      "additionalProperties": false
    }
  }
}
