{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://governance/authority-sources/1.0.0",
  "title": "AuthoritySources",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_id", "authority_revision", "contract_version", "seed_source_commit", "repositories", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "authority_id": {"type": "string", "minLength": 1},
    "authority_revision": {"type": "integer", "minimum": 1},
    "contract_version": {"const": "2.1.3"},
    "seed_source_commit": {"$ref": "#/$defs/commit"},
    "repositories": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["source_commit"],
        "properties": {"source_commit": {"$ref": "#/$defs/commit"}}
      }
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["class", "repository", "path"],
        "properties": {
          "class": {"enum": ["production_contract", "implementation_contract", "schema_source", "registry_source", "architecture_gate", "blocking_fixture"]},
          "repository": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
}
