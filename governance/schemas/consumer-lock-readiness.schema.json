{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://governance/consumer-lock-readiness/1.0.0",
  "title": "ConsumerLockReadinessReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "receipt_id",
    "authority_lock_hash",
    "decision",
    "reason_codes",
    "produced_at",
    "task_id",
    "authority_governance_commit",
    "authority_bundle_hash",
    "consumer_repository_commit",
    "consumer_commit_tree_oid",
    "consumer_index_tree_oid",
    "consumer_lock_path",
    "state",
    "reason",
    "profile_policy_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_type": {
      "const": "consumer_lock_readiness"
    },
    "receipt_id": {
      "$ref": "#/$defs/sha256"
    },
    "authority_lock_hash": {
      "$ref": "#/$defs/sha256"
    },
    "decision": {
      "const": "not_applicable"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_governance_commit": {
      "$ref": "#/$defs/git_oid"
    },
    "authority_bundle_hash": {
      "$ref": "#/$defs/sha256"
    },
    "consumer_repository_commit": {
      "$ref": "#/$defs/git_oid"
    },
    "consumer_commit_tree_oid": {
      "$ref": "#/$defs/git_oid"
    },
    "consumer_index_tree_oid": {
      "$ref": "#/$defs/git_oid"
    },
    "consumer_lock_path": {
      "const": "governance/authority-consumer.lock.yaml"
    },
    "state": {
      "const": "not_materialized"
    },
    "reason": {
      "const": "kernel_build_not_yet_available"
    },
    "profile_policy_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
