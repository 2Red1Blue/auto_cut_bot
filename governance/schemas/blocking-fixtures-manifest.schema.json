{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://governance/blocking-fixtures-manifest/1.0.0",
  "title": "BlockingFixturesManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activation_profile", "fixtures"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "activation_profile": {"const": "authority_bootstrap"},
    "fixtures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fixture_id", "runner_id", "path", "sha256", "expected_decision", "expected_reason_code"],
        "properties": {
          "fixture_id": {"type": "string", "pattern": "^AUTH-[A-Z0-9-]+$"},
          "runner_id": {"enum": ["task_manifest_mutation", "model_role_mutation", "context_content", "receipt_decision", "offline_remote_evidence", "candidate_secret", "candidate_collision", "candidate_legal_session", "candidate_synthetic_profile", "candidate_synthetic_outside", "bootstrap_chain", "pre_a_phase_mix", "fake_tree_oid", "validation_self_report"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "expected_decision": {"enum": ["allow", "deny"]},
          "expected_reason_code": {"type": ["string", "null"], "minLength": 1}
        }
      }
    }
  }
}
