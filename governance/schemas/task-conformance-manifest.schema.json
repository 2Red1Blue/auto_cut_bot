{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://governance/task-conformance-manifest/1.0.0",
  "title": "TaskConformanceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "task_type", "risk_class", "activation_profile",
    "authority_lock_hash", "registry_binding", "repository", "branch", "base_branch",
    "worktree_path", "predecessor_commit", "repository_refs", "allowed_write_paths",
    "forbidden_runtime_import_roots", "permitted_legacy_read_roots", "planning_artifacts",
    "implementation_context", "check_context", "validation_commands", "implementer",
    "checker_requirements", "authority_change"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["implementation", "authority_change"]},
    "risk_class": {"enum": ["authority", "high", "bounded", "mechanical"]},
    "activation_profile": {"enum": ["authority_bootstrap", "authority_package_skeleton", "contract_foundation", "kernel_execution", "stage_business", "cutover"]},
    "authority_lock_hash": {"$ref": "#/$defs/sha256"},
    "registry_binding": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "registry_set_hash", "authority_hash"],
          "properties": {"kind": {"const": "present"}, "registry_set_hash": {"$ref": "#/$defs/sha256"}, "authority_hash": {"$ref": "#/$defs/sha256"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "profile", "minimum_phase", "current_phase", "reason", "authority_hash"],
          "properties": {
            "kind": {"const": "not_applicable"},
            "profile": {"enum": ["authority_bootstrap", "authority_package_skeleton", "contract_foundation", "kernel_execution", "stage_business", "cutover"]},
            "minimum_phase": {"$ref": "#/$defs/phase"},
            "current_phase": {"$ref": "#/$defs/phase"},
            "reason": {"type": "string", "minLength": 1},
            "authority_hash": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "repository": {"type": ["string", "null"], "minLength": 1},
    "branch": {"type": ["string", "null"], "minLength": 1},
    "base_branch": {"type": ["string", "null"], "minLength": 1},
    "worktree_path": {"type": ["string", "null"], "minLength": 1},
    "predecessor_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
    "repository_refs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/repository_ref"}
    },
    "allowed_write_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path_rule"}},
    "forbidden_runtime_import_roots": {"type": "array", "items": {"$ref": "#/$defs/path_rule"}},
    "permitted_legacy_read_roots": {"type": "array", "items": {"$ref": "#/$defs/legacy_read"}},
    "planning_artifacts": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/planning_artifact"}},
    "implementation_context": {"$ref": "#/$defs/context_file"},
    "check_context": {"$ref": "#/$defs/context_file"},
    "validation_commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation_command"}},
    "implementer": {
      "type": "object", "additionalProperties": false,
      "required": ["run_identity", "model_family", "reasoning_class"],
      "properties": {
        "run_identity": {"type": "string", "minLength": 1},
        "model_family": {"type": "string", "minLength": 1},
        "reasoning_class": {"enum": ["low", "medium", "high", "xhigh"]}
      }
    },
    "checker_requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["independent_run_required", "independent_context_required", "required_class"],
      "properties": {
        "independent_run_required": {"const": true},
        "independent_context_required": {"const": true},
        "required_class": {"enum": ["authority", "high", "bounded"]}
      }
    },
    "authority_change": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["old_lock_hash", "new_lock_hash", "compatibility_impact", "invalidated_tasks"],
          "properties": {
            "old_lock_hash": {"$ref": "#/$defs/sha256"},
            "new_lock_hash": {"$ref": "#/$defs/sha256"},
            "compatibility_impact": {"type": "string", "minLength": 1},
            "invalidated_tasks": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "repository": {"type": "string"}, "branch": {"type": "string"},
        "base_branch": {"type": "string"}, "worktree_path": {"type": "string"},
        "predecessor_commit": {"$ref": "#/$defs/commit"}, "repository_refs": {"maxProperties": 0}
      }
    },
    {
      "properties": {
        "repository": {"type": "null"}, "branch": {"type": "null"},
        "base_branch": {"type": "null"}, "worktree_path": {"type": "null"},
        "predecessor_commit": {"type": "null"}, "repository_refs": {"minProperties": 2}
      }
    }
  ],
  "allOf": [
    {"if": {"properties": {"task_type": {"const": "implementation"}}}, "then": {"properties": {"authority_change": {"type": "null"}}}},
    {"if": {"properties": {"task_type": {"const": "authority_change"}}}, "then": {"properties": {"authority_change": {"type": "object"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "phase": {"enum": ["phase_minus_1", "phase_0", "phase_1", "phase_2", "phase_3", "phase_4", "phase_5", "phase_6"]},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "repository_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "base_branch", "worktree_path", "predecessor_commit"],
      "properties": {
        "branch": {"type": "string", "minLength": 1}, "base_branch": {"type": "string", "minLength": 1},
        "worktree_path": {"type": "string", "pattern": "^/", "minLength": 2}, "predecessor_commit": {"$ref": "#/$defs/commit"}
      }
    },
    "path_rule": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "pattern"],
      "properties": {"repository": {"type": "string", "minLength": 1}, "pattern": {"$ref": "#/$defs/relative_path"}}
    },
    "legacy_read": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "pattern", "purpose", "audit_required"],
      "properties": {
        "repository": {"type": "string", "minLength": 1}, "pattern": {"$ref": "#/$defs/relative_path"},
        "purpose": {"enum": ["inventory", "fixture", "offline_eval"]}, "audit_required": {"const": true}
      }
    },
    "context_file": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "path", "sha256", "byte_length"],
      "properties": {
        "repository": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"type": "integer", "minimum": 1}
      }
    },
    "planning_artifact": {
      "allOf": [
        {"$ref": "#/$defs/context_file"},
        {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["prd", "design", "implement", "implement_context", "check_context"]}}}
      ],
      "unevaluatedProperties": false
    },
    "validation_command": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id", "repository", "argv"],
      "properties": {
        "command_id": {"type": "string", "minLength": 1}, "repository": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
