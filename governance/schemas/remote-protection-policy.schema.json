{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://governance/remote-protection-policy/1.0.0",
  "title": "RemoteProtectionPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_remote_url", "target_ref", "allowed_collector_ids", "required_check_ids", "require_codeowners", "deny_direct_push", "max_attestation_ttl_seconds"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "canonical_remote_url": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "pattern": "^refs/heads/", "minLength": 12},
    "allowed_collector_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_check_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "require_codeowners": {"const": true},
    "deny_direct_push": {"const": true},
    "max_attestation_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  }
}
