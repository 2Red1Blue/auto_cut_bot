{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://governance/model-role-policy/1.0.0",
  "title": "ModelRolePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "risk_assignments", "independence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "risk_assignments": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "high", "bounded", "mechanical"],
      "properties": {
        "authority": {"$ref": "#/$defs/assignment"}, "high": {"$ref": "#/$defs/assignment"},
        "bounded": {"$ref": "#/$defs/assignment"}, "mechanical": {"$ref": "#/$defs/assignment"}
      }
    },
    "independence": {
      "type": "object", "additionalProperties": false,
      "required": ["different_run_identity_required", "different_context_hash_required", "protected_oracle_required"],
      "properties": {
        "different_run_identity_required": {"const": true}, "different_context_hash_required": {"const": true}, "protected_oracle_required": {"const": true}
      }
    }
  },
  "$defs": {
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_model_families", "allowed_reasoning_classes"],
      "properties": {
        "allowed_model_families": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "allowed_reasoning_classes": {"type": "array", "minItems": 1, "items": {"enum": ["low", "medium", "high", "xhigh"]}, "uniqueItems": true}
      }
    }
  }
}
