{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://governance/runtime-conformance/1.0.0",
  "title": "RuntimeConformanceReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "receipt_id",
    "authority_lock_hash",
    "decision",
    "reason_codes",
    "produced_at",
    "task_id",
    "predicate_id",
    "profile",
    "minimum_phase",
    "current_phase",
    "status",
    "reason",
    "profile_policy_hash",
    "profile_signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_type": {
      "const": "runtime_conformance"
    },
    "receipt_id": {
      "$ref": "#/$defs/sha256"
    },
    "authority_lock_hash": {
      "$ref": "#/$defs/sha256"
    },
    "decision": {
      "enum": [
        "allow",
        "deny",
        "not_applicable"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "predicate_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "minimum_phase": {
      "enum": [
        "phase_minus_1",
        "phase_0",
        "phase_1",
        "phase_2",
        "phase_3",
        "phase_4",
        "phase_5",
        "phase_6"
      ]
    },
    "current_phase": {
      "enum": [
        "phase_minus_1",
        "phase_0",
        "phase_1",
        "phase_2",
        "phase_3",
        "phase_4",
        "phase_5",
        "phase_6"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "not_applicable"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "profile_policy_hash": {
      "$ref": "#/$defs/sha256"
    },
    "profile_signature": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
