{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://governance/task-authorizations/1.0.0",
  "title": "TaskAuthorizations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_revision", "activation_profile_bindings", "authorizations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "authority_revision": {"type": "integer", "minimum": 1},
    "activation_profile_bindings": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "required_profile"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "required_profile": {"enum": ["authority_bootstrap", "authority_package_skeleton", "contract_foundation", "kernel_execution", "stage_business", "cutover"]}
        }
      }
    },
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authorization_id", "task_id", "task_type", "allowed_protected_paths", "approved_by"],
        "properties": {
          "authorization_id": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "task_type": {"const": "authority_change"},
          "allowed_protected_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path_rule"}},
          "approved_by": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "path_rule": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "pattern"],
      "properties": {"repository": {"type": "string", "minLength": 1}, "pattern": {"type": "string", "minLength": 1}}
    }
  }
}
